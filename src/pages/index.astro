---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import portrait from '../../assets/profile_photo_kaiyuan_wang.png';
import About, { frontmatter as profile } from './_index.md';
---

<SiteLayout>
  <header class="profile">
    <Image
      class="portrait"
      src={portrait}
      alt="Kaiyuan Wang"
      width={240}
      height={240}
      widths={[120, 240, 360]}
      sizes="(max-width: 600px) 150px, 120px"
      format="webp"
      loading="eager"
    />
    <div class="profile-text">
      <h1>
        <span class="has-tooltip" tabindex="0" aria-describedby="native-name">
          {profile.name}
          <span class="tooltip" id="native-name" lang="zh-Hans" role="tooltip">{profile.native_name}</span>
        </span>
      </h1>
      <div class="affiliation-row">
        <p>{profile.role} <span aria-hidden="true">|</span> <a href={profile.lab_url}>{profile.lab}</a>, {profile.university}</p>
        <nav aria-label="Contact and profiles">
          {profile.links.map((link: { label: string; href: string; icon: string }) => {
            const email = link.href.startsWith('mailto:') ? link.href.slice('mailto:'.length) : undefined;
            return (
              <>
                <span aria-hidden="true">|</span>
                <a
                  href={link.href}
                  aria-label={link.label}
                  class:list={[{ 'has-tooltip': email }]}
                  aria-describedby={email ? 'email-address' : undefined}
                  title={email ? undefined : link.label}
                >
                  <img src={link.icon} alt="" width="21" height="21" />
                  {email && <span class="tooltip" id="email-address" role="tooltip">{email}</span>}
                </a>
              </>
            );
          })}
        </nav>
      </div>
    </div>
  </header>

  <section aria-labelledby="research-heading">
    <h2 id="research-heading">Research interests</h2>
    <About />
  </section>

  <section aria-labelledby="publications-heading">
    <h2 id="publications-heading">Publications</h2>
  </section>

  <section aria-labelledby="blog-heading">
    <h2 id="blog-heading">Blog</h2>
    <ul>
      <li><a href="/blog/261123_math_research_in_ai_era.html">When Proofs Become Cheap: Math Research in the Age of AI</a></li>
      <li>
        <a href="/blog/261117_why_is_l1_sparsity_inducing.html">
          Why is <math><msub><mi>ℓ</mi><mn>1</mn></msub></math> Regularization Sparsity-Inducing?
        </a>
      </li>
    </ul>
  </section>
</SiteLayout>

<style>
  .profile { display: flex; align-items: center; gap: 24px; padding-bottom: 28px; border-bottom: 1px solid #e0e0e0; }
  .portrait { width: 120px; height: 120px; flex-shrink: 0; border-radius: 50%; object-fit: cover; }
  .profile-text { min-width: 0; }
  h1 { margin: 0 0 6px; font-size: clamp(32px, 4.3vw, 52px); line-height: 1.13; letter-spacing: -0.035em; }
  .has-tooltip { position: relative; }
  .tooltip {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: 100%;
    transform: translateX(-50%);
    width: max-content;
    padding: 4px 8px;
    border-radius: 4px;
    background: #2c3c4c;
    color: white;
    font-size: 14px;
    line-height: 1.4;
    letter-spacing: normal;
    visibility: hidden;
  }
  nav .tooltip { top: 100%; bottom: auto; }
  .has-tooltip:hover > .tooltip, .has-tooltip:focus-visible > .tooltip { visibility: visible; }
  .affiliation-row { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; }
  .affiliation-row p { margin: 0; }
  nav { display: flex; align-items: center; gap: 4px; }
  nav a { display: inline-grid; place-items: center; width: 28px; height: 32px; }
  section { margin-top: 40px; }
  h2 { margin: 0 0 12px; font-size: clamp(24px, 3vw, 30px); line-height: normal; letter-spacing: -0.025em; }
  section :global(p) { margin: 0; }
  @media (max-width: 600px) {
    .profile { flex-direction: column; text-align: center; gap: 20px; }
    .portrait { width: 150px; height: 150px; }
    .affiliation-row { justify-content: center; }
    section { margin-top: 32px; }
  }
</style>
