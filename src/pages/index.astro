---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import portrait from '../../assets/profile_photo_kaiyuan_wang.png';
import About, { frontmatter as profile } from './_index.md';
---

<SiteLayout>
  <header class="profile">
    <Image
      class="portrait"
      src={portrait}
      alt="Kaiyuan Wang"
      width={240}
      height={240}
      widths={[120, 240, 360]}
      sizes="(max-width: 600px) 150px, 120px"
      format="webp"
      loading="eager"
    />
    <div class="profile-text">
      <h1>{profile.name} <span lang="zh-Hans">{profile.native_name}</span></h1>
      <div class="affiliation-row">
        <p>{profile.role}</p>
        <nav aria-label="Contact and profiles">
          {profile.links.map((link: { label: string; href: string; icon: string }) => (
            <a href={link.href} aria-label={link.label} title={link.label}>
              <img src={link.icon} alt="" width="21" height="21" />
            </a>
          ))}
        </nav>
      </div>
    </div>
  </header>

  <section aria-labelledby="research-heading">
    <h2 id="research-heading">Research interests</h2>
    <About />
  </section>

  <section aria-labelledby="publications-heading">
    <h2 id="publications-heading">Publications</h2>
  </section>

  <section aria-labelledby="blog-heading">
    <h2 id="blog-heading">Blog</h2>
  </section>
</SiteLayout>

<style>
  .profile { display: flex; align-items: center; gap: 24px; padding-bottom: 28px; border-bottom: 1px solid #e0e0e0; }
  .portrait { width: 120px; height: 120px; flex-shrink: 0; border-radius: 50%; object-fit: cover; }
  .profile-text { min-width: 0; }
  h1 { margin: 0 0 6px; font-size: 36px; line-height: 1.2; letter-spacing: -0.025em; }
  h1 span { display: inline-block; margin-left: 8px; font-size: 22px; letter-spacing: 0; color: #5f6c78; }
  .affiliation-row { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 12px; }
  .affiliation-row p { margin: 0; }
  nav { display: flex; gap: 4px; }
  nav a { display: inline-grid; place-items: center; width: 28px; height: 32px; }
  section { margin-top: 40px; }
  h2 { margin: 0 0 12px; font-size: 24px; }
  section :global(p) { margin: 0; }
  @media (max-width: 600px) {
    .profile { flex-direction: column; text-align: center; gap: 20px; }
    .portrait { width: 150px; height: 150px; }
    h1 { font-size: 32px; }
    h1 span { display: block; margin: 8px 0 0; font-size: 20px; }
    .affiliation-row { justify-content: center; }
    section { margin-top: 32px; }
  }
</style>
